# docker compose --env-file .env.back -f docker-compose.back.yml up -d
# BACK_PRIVATE_IP에는 이 뒷단 Lightsail 인스턴스의 사설 IP만 지정한다.
BACK_PRIVATE_IP=10.0.0.20

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE=tech_trends

# BullMQ 전용 Redis
REDIS_QUEUE_PASSWORD=replace-with-a-long-random-password

# scripts/backup-postgres-to-s3.sh 설정
# S3 버킷은 리전·계정 정책에 맞게 미리 생성하고, 이 인스턴스에 최소 권한 IAM 자격 증명을 설정한다.
S3_BUCKET=replace-with-backup-bucket
S3_PREFIX=tech-trends/postgres
RETENTION_DAYS=7
BACKUP_DIR=/home/ubuntu/backups/tech-trends
