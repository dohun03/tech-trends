# docker compose --env-file .env.front -f docker-compose.front.yml up -d --build

# Server
PORT=3000
NODE_ENV=production
TZ=Asia/Seoul

# 뒷단 인스턴스의 프라이빗 IP. docker-compose.front.yml이 이 값을 앱 키로 매핑한다.
DATABASE_HOST=10.0.0.20
DATABASE_PORT=5432
REDIS_QUEUE_HOST=10.0.0.20
REDIS_QUEUE_PORT=6379

# Database
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE=tech_trends

# BullMQ 전용 Redis (뒷단 인스턴스)
REDIS_QUEUE_PASSWORD=replace-with-a-long-random-password

# Cache/Throttler Redis는 앞단 compose 내부 redis-cache를 사용한다.
# 아래 키는 로컬 개발 등 compose 밖에서 실행할 때만 필요하다.
# REDIS_CACHE_HOST=localhost
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_PASSWORD=

# CORS / client
CORS_ORIGIN=https://example.com
CLIENT_URL=https://example.com

# Rate limit
SEARCH_THROTTLE_LIMIT=5
SEARCH_THROTTLE_TTL=10000

# Search
SEARCH_CANDIDATE_LIMIT=50
VECTOR_DISTANCE_THRESHOLD=0.30
RELATED_DISTANCE_THRESHOLD=0.45
EMBEDDING_TTL_SECONDS=2592000
TRENDS_SOURCES_CACHE_TTL_SECONDS=86400

# Scraper / scheduler
CRON_SCHEDULE="0 2 * * *"
SCRAPER_TARGET_SAVE_COUNT=5
SCRAPER_BATCH_SIZE=10
SCRAPER_REDIS_LOCK_TTL_MS=600000
SCRAPER_AI_DELAY_SECONDS=3
SCRAPER_TEXT_SNIPPET_LENGTH=600
SCRAPER_TEXT_CONTENT_LENGTH=5000

# AI providers
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=replace-with-gemini-api-key
GROQ_MODEL=replace-with-groq-model
GROQ_MAX_COMPLETION_TOKENS=1000
GROQ_API_KEY=replace-with-groq-api-key

# Discord webhooks
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_USER_WEBHOOK_URL=
